          },
          {
            "name": "ClassSortWithinShow",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ],
            "dataType": "string",
            "expression": [
              "",
              "VAR StartDate = RELATED(dimShows[StartDate])  // Adjust to your show key column name",
              "VAR ClassSort = dimClasses[ClassNumberSort]",
              "",
              "RETURN",
              "    StartDate & \"|\" & ClassSort"
            ],
            "isDataTypeInferred": true,
