              "VAR PlaceText = vwResults[Place]",
              "VAR OfPosition = FIND(\" of \", PlaceText, 1, 0)",
              "RETURN",
              "IF(",
              "    OfPosition > 0,",
              "    LEFT(PlaceText, OfPosition - 1),",
              "    PlaceText",
              ")"
            ],
