      {
        "name": "_Measures",
        "columns": [
          {
            "name": "MeasureGroup",
            "dataType": "string",
            "isDataTypeInferred": true,
            "isNameInferred": true,
            "lineageTag": "b0eb4803-21c5-4b57-814e-54adbac9bae9",
            "sourceColumn": "[MeasureGroup]",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "8a6d67cb-74eb-491d-ba8d-adfb9bf877ce",
        "measures": [
          {
            "name": "Total Entries",
            "expression": "COUNTROWS(factResults)",
            "lineageTag": "fc3c4f15-62b6-4139-982a-afc92a63b6aa"
          },
          {
            "name": "Total Shows",
            "expression": "DISTINCTCOUNT(factResults[ShowID])",
            "lineageTag": "53c36d34-28e2-441c-a0ca-96be999d2a35"
          },
          {
            "name": "Total Classes",
            "expression": "DISTINCTCOUNT(factResults[ClassID])",
            "lineageTag": "fd820ff7-6a41-48cd-a6fa-8f2bb9b657d1"
          },
          {
            "name": "Unique Riders",
            "expression": "DISTINCTCOUNT(factResults[RiderID])",
            "lineageTag": "a8762d20-f351-4222-9da5-b3393fccbdba"
          },
          {
            "name": "Unique Horses",
            "expression": "DISTINCTCOUNT(factResults[HorseID])",
            "lineageTag": "78413aae-b143-4ee4-9714-8150a17671a5"
          },
          {
            "name": "Unique Trainers",
            "expression": "DISTINCTCOUNT(factResults[TrainerID])",
            "lineageTag": "b5d30cdf-99a4-4f3b-b9cb-ddecd0004966"
          },
          {
            "name": "First Places",
            "expression": "SUM(factResults[IsFirstPlace])",
            "lineageTag": "2f3b176c-3561-4824-8b7e-678d34a20e5a"
          },
          {
            "name": "Top 3 Places",
            "expression": "SUM(factResults[IsTopThree])",
            "lineageTag": "f28166f5-e670-418e-8a15-d38801bd1bfa"
          },
          {
            "name": "Top 6 Places",
            "expression": "SUM(factResults[IsTopSix])",
            "lineageTag": "15b1f0ef-f2a1-46e9-bedc-f0442bb20acf"
          },
          {
            "name": "Total Placements",
            "expression": "SUM(factResults[IsPlacing])",
            "lineageTag": "e8485b85-b7b7-47a3-be81-2ddc1130c805"
          },
          {
            "name": "Non-Placements",
            "expression": "CALCULATE(COUNTROWS(factResults), factResults[Place] = 0)",
            "lineageTag": "bccc71cc-708d-4047-8c22-0c254b7a85b1"
          },
          {
            "name": "Placement Rate %",
            "expression": "DIVIDE([Total Placements], [Total Entries], 0) * 100",
            "lineageTag": "d2e4304e-6e0d-4e8e-8f63-12115171a450"
          },
          {
            "name": "First Place Rate %",
            "expression": "DIVIDE([First Places], [Total Entries], 0) * 100",
            "lineageTag": "2c79664d-0910-4a56-8501-b278cb606738"
          },
          {
            "name": "Top 3 Rate %",
            "expression": "DIVIDE([Top 3 Places], [Total Entries], 0) * 100",
            "lineageTag": "73baede1-1d5e-4a5b-8430-263a086e3e9a"
          },
          {
            "name": "Total Prize Money",
            "expression": "SUM(factResults[PrizeMoney])",
            "lineageTag": "515e44aa-72f4-4fa2-8205-80dfab609145"
          },
          {
            "name": "Average Prize Money",
            "expression": "AVERAGE(factResults[PrizeMoney])",
            "lineageTag": "e24b3c78-8bed-4ccd-b28f-cf9f4f62ae7c"
          },
          {
            "name": "Average Placement",
            "expression": "AVERAGEX(FILTER(factResults, factResults[Place] > 0), factResults[Place])",
            "lineageTag": "f3e71140-c389-45a6-b994-f8dd6e57a519"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "expression": "ROW(\"MeasureGroup\", \"_Measures\")",
              "type": "calculated"
            }
          }
        ]
      },
