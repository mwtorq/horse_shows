            "dataType": "double",
            "expression": [
              "",
              "VAR PlaceText = vwResults[Place]",
              "VAR OfPosition = FIND(\" of \", PlaceText, 1, 0)",
              "VAR PlaceValue = IF(OfPosition > 0, LEFT(PlaceText, OfPosition - 1), PlaceText)",
              "VAR PlaceIsNumeric = NOT ISERROR(VALUE(PlaceValue))",
              "RETURN",
              "IF(",
              "    PlaceIsNumeric,",
              "    VALUE(PlaceValue),",
              "    999999  // Non-numeric places (like \"DNP\") sort last",
              ")"
            ],
            "isDataTypeInferred": true,
